# Copy to .env for local development. Never commit real values.
JENNIFER_ENV=development            # development | staging | production
PORT=8787
JENNIFER_OWNER_ID=bruno
JENNIFER_HOME_TZ=Europe/Rome
JENNIFER_API_TOKEN=                 # bootstrap/break-glass owner token; cannot satisfy step-up
JENNIFER_DEVELOPER_TOKEN=           # optional: developer role (connections + redacted audit only)
JENNIFER_WEBHOOK_SECRET=            # HMAC secret for provider webhook relay
DATABASE_URL=                       # Postgres (Cloud SQL in staging/prod). Dev without it uses on-disk PGlite in .data/
JENNIFER_RP_ID=localhost            # passkey relying-party domain (e.g. jennifer.example.com)
JENNIFER_ORIGINS=http://localhost:8787   # comma-separated WebAuthn origins
JENNIFER_VAULT_KEYS=                # dev only: "1:<base64 32 bytes>"; staging/prod use JENNIFER_KMS_KEY
JENNIFER_EMAIL_SANDBOX=             # comma-separated: while set, Jennifer may only send to these addresses (first live tests)
JENNIFER_SEED=0                     # 1 = load simulator demo data (never with a real inbox)
JENNIFER_KMS_KEY=                   # projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>
OPENAI_API_KEY=                     # server side only; never shipped to clients
OPENAI_WEBHOOK_SECRET=              # phone calls: OpenAI webhook signing secret (whsec_...)
JENNIFER_TRANSFER_NUMBER=           # your own number for warm call transfers (E.164), optional
JENNIFER_VAPID_PUBLIC=              # optional: push keys (generated and kept in the vault if empty)
JENNIFER_VAPID_PRIVATE=
JENNIFER_REASONING_MODEL=gpt-5
JENNIFER_FAST_MODEL=gpt-5-mini
JENNIFER_REALTIME_MODEL=gpt-realtime
JENNIFER_PROMPT_VERSION=jennifer-2026-10-01
JENNIFER_MONTHLY_CEILING_EUR=1000
JENNIFER_TASK_MAX_EUR=0.5
JENNIFER_CALL_MAX_MINUTES=20
# Claude as Jennifer's brain (optional). Voice and phone stay on OpenAI Realtime.
ANTHROPIC_API_KEY=
MODEL_PROVIDER=auto                 # auto | openai | anthropic (auto = OpenAI when its key is set)
JENNIFER_CLAUDE_MODEL=claude-opus-5-5
JENNIFER_CLAUDE_EFFORT=medium       # low | medium | high | xhigh | max
# Cost estimates: override the price table after checking current vendor rates (EUR per million tokens / per minute).
JENNIFER_PRICING_JSON=
# SMS on Jennifer's number (Twilio; for SignalWire also set TWILIO_API_BASE=https://<space>.signalwire.com/api/laml)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_BASE=
JENNIFER_SMS_FROM=                  # Jennifer's number, E.164
JENNIFER_ALERT_SMS_TO=              # your mobile: urgent alerts when push is unavailable
JENNIFER_PUBLIC_URL=                # https URL Jennifer is served at (Render sets RENDER_EXTERNAL_URL)
# Retention in days (0 = keep)
JENNIFER_RETAIN_MESSAGES_DAYS=365
JENNIFER_RETAIN_CALLS_DAYS=90
JENNIFER_RETAIN_AUDIT_DAYS=730
JENNIFER_RETAIN_FEEDBACK_DAYS=365
