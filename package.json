{
  "name": "jennifer",
  "version": "0.1.0",
  "private": true,
  "description": "Jennifer — Bruno's persistent executive assistant (backend foundation, policy engine, action pipeline and local simulator)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/api/main.ts",
    "simulate": "tsx src/simulator/demo.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.5",
    "luxon": "^3.7.2",
